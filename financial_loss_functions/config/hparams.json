{
    "rolling_windows": {
        "in_size": 200,
        "out_size": 50,
        "stride": 1
    },
    "models": {
        "BaseLSTM": {
            "model": {
                "hidden_size": 256,
                "num_layers": 2,
                "dropout": 0.2,
                "equal_prior": false
            },
            "optimizer": {
                "lr": 1e-4,
                "weight_decay": 1e-5
            },
            "train" : {
                "train_batch_size": 256,
                "val_batch_size": 1,
                "clip_grad_norm": 0.5,
                "epochs": 100
            }
        },
        "AttentionLSTM": {
            "model": {
                "hidden_size": 128,
                "num_layers": 3,
                "attention_heads": 2,
                "dropout": 0.2,
                "equal_prior": false
            },
            "optimizer": {
                "lr": 1e-4,
                "weight_decay": 1e-5
            },
            "train": {
                "train_batch_size": 256,
                "val_batch_size": 1,
                "clip_grad_norm": 0.5,
                "epochs": 100
            }
        }
    },
    "losses": {
        "custom_loss_1" : {
            "lambda1": 0.001
        }
    }
}
