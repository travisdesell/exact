{   
    "seed_list": [50, 42, 67, 313, 3],

    "tuner": {
        "n_tuning_trials": 20,
        "n_jobs": 1
    },
    "rolling_windows": {
        "in_size": 120,
        "out_size": 60,
        "stride": 1
    },
    "nn_models": {
        "BaseLSTM": {
            "model": {
                "hidden_size": 16,
                "num_layers": 4,
                "dropout": 0.2,
                "equal_prior": false
            },
            "optimizer": {
                "lr": 1e-4,
                "weight_decay": 1e-2
            },
            "train" : {
                "train_batch_size": 64,
                "val_batch_size": 64,
                "clip_grad_norm": 0.5,
                "epochs": 200,
                "min_epochs": 10,
                "early_stopping": true,
                "early_stop_patience": 20,
                "early_stop_min_delta": 1e-5
            },
            "scheduler": {
                "factor": 0.5,
                "patience": 10,
                "min_lr": 1e-6
            },
            "tuning": {
                "hidden_size": {"type": "categorical", "choices": [16, 32, 64]},
                "num_layers": {"type": "categorical", "choices": [1, 2, 4]},
                "dropout": {"type": "float", "low": 0.1, "high": 0.5, "log": false},
                "lr": {"type": "float", "low": 1e-5, "high": 1e-2, "log": true},
                "weight_decay": {"type": "float", "low": 1e-4, "high": 1e-1, "log": true}
            }
        },
        "AttentionLSTM": {
            "model": {
                "hidden_size": 16,
                "num_layers": 4,
                "nheads": 2,
                "dropout": 0.2,
                "equal_prior": false
            },
            "optimizer": {
                "lr": 1e-4,
                "weight_decay": 1e-2
            },
            "train": {
                "train_batch_size": 64,
                "val_batch_size": 64,
                "clip_grad_norm": 0.5,
                "epochs": 500,
                "min_epochs": 10,
                "early_stopping": true,
                "early_stop_patience": 20,
                "early_stop_min_delta": 1e-5
            },
            "scheduler": {
                "factor": 0.5,
                "patience": 10,
                "min_lr": 1e-6
            },
            "tuning": {
                "hidden_size": {"type": "categorical", "choices": [16, 32, 64]},
                "num_layers": {"type": "categorical", "choices": [1, 2, 4]},
                "nheads":{"type": "categorical", "choices":[1, 2, 4, 8]},
                "dropout": {"type": "float", "low": 0.1, "high": 0.5, "log": false},
                "lr": {"type": "float", "low": 1e-5, "high": 1e-3, "log": true},
                "weight_decay": {"type": "float", "low": 1e-4, "high": 1e-1, "log": true}
            }
        },
        "TFT": {
            "model": {
                "hidden_size": 16,
                "num_layers": 1,
                "nheads": 2,
                "dropout": 0.4,
                "expansion_factor": 2,
                "equal_prior": false
            },
            "optimizer": {
                "lr": 1e-4,
                "weight_decay": 1e-2
            },
            "train": {
                "train_batch_size": 64,
                "val_batch_size": 64,
                "clip_grad_norm": 0.5,
                "epochs": 200,
                "min_epochs": 10,
                "early_stopping": true,
                "early_stop_patience": 20,
                "early_stop_min_delta": 1e-5
            },
            "scheduler": {
                "factor": 0.5,
                "patience": 10,
                "min_lr": 1e-6
            },
            "tuning": {
                "hidden_size": {"type": "categorical", "choices": [16, 32, 64, 128]},
                "num_layers": {"type": "categorical", "choices": [1, 2, 4]},
                "nheads":{"type": "categorical", "choices":[1, 2, 4, 8]},
                "dropout": {"type": "float", "low": 0.1, "high": 0.5, "log": false},
                "lr": {"type": "float", "low": 1e-5, "high": 1e-3, "log": true},
                "weight_decay": {"type": "float", "low": 1e-4, "high": 1e-1, "log": true}
            }
        },
        "TemporalTransformer": {
            "model": {
                "hidden_size": 32,
                "lstm_layers": 2,
                "trans_layers": 1,
                "nheads": 2,
                "dropout": 0.5,
                "expansion_factor": 4,
                "equal_prior": false
            },
            "optimizer": {
                "lr": 1e-5,
                "weight_decay": 1e-3
            },
            "train": {
                "train_batch_size": 64,
                "val_batch_size": 64,
                "clip_grad_norm": 0.5,
                "epochs": 200,
                "min_epochs": 10,
                "early_stopping": true,
                "early_stop_patience": 20,
                "early_stop_min_delta": 1e-5
            },
            "scheduler": {
                "factor": 0.5,
                "patience": 10,
                "min_lr": 1e-8
            },
            "tuning": {
                "hidden_size": {"type": "categorical", "choices": [16, 32, 64, 128]},
                "lstm_layers": {"type": "categorical", "choices": [1, 2, 4]},
                "trans_layers": {"type": "categorical", "choices": [1, 2]},
                "nheads":{"type": "categorical", "choices":[1, 2, 4, 8]},
                "dropout": {"type": "float", "low": 0.1, "high": 0.5, "log": false},
                "expansion_factor": {"type": "categorical", "choices": [1, 2, 4]},
                "lr": {"type": "float", "low": 1e-6, "high": 1e-3, "log": true},
                "weight_decay": {"type": "float", "low": 1e-4, "high": 1e-1, "log": true}
            }
        },
        "InvertedAttentionLSTM": {
            "model": {
                "hidden_size": 16,
                "num_layers": 4,
                "nheads": 8,
                "dropout": 0.5,
                "equal_prior": false
            },
            "optimizer": {
                "lr": 1e-4,
                "weight_decay": 1e-3
            },
            "train": {
                "train_batch_size": 64,
                "val_batch_size": 64,
                "clip_grad_norm": 0.5,
                "epochs": 200,
                "min_epochs": 10,
                "early_stopping": true,
                "early_stop_patience": 20,
                "early_stop_min_delta": 1e-5
            },
            "scheduler": {
                "factor": 0.5,
                "patience": 10,
                "min_lr": 1e-6
            },
            "tuning": {
                "hidden_size": {"type": "categorical", "choices": [16, 32, 64, 128]},
                "num_layers": {"type": "categorical", "choices": [1, 2, 4]},
                "nheads":{"type": "categorical", "choices":[1, 2, 4, 8]},
                "dropout": {"type": "float", "low": 0.1, "high": 0.5, "log": false},
                "lr": {"type": "float", "low": 1e-6, "high": 1e-2, "log": true},
                "weight_decay": {"type": "float", "low": 1e-4, "high": 1e-1, "log": true}
            }
        },
        "DeformTime": {
            "model": {
                "seq_len": 120,
                "e_layers": 2,
                "d_layers": 2,
                "d_model": 16,
                "nheads": 4,
                "kernel_size": 4,
                "dropout": 0.2,
                "n_reshape": 12,
                "patch_len": 6,
                "stride": 6
            },
            "optimizer": {
                "lr": 1e-4,
                "weight_decay": 1e-3
            },
            "train": {
                "train_batch_size": 64,
                "val_batch_size": 64,
                "clip_grad_norm": 0.5,
                "epochs": 200,
                "early_stopping": true,
                "early_stop_patience": 20,
                "early_stop_min_delta": 1e-5
            },
            "scheduler": {
                "factor": 0.5,
                "patience": 10,
                "min_lr": 1e-6
            }
        },
        "BiAttentionLSTM": {
            "model": {
                "feats_per_stock": 5,
                "num_global": 1,
                "hidden_size": 16,
                "lstm_layers": 2,
                "t_nheads": 4,
                "r_nheads": 8,
                "cont_hidden": 16,
                "cont_layers": 1,
                "cont_kernel": 3,
                "dropout": 0.2,
                "max_seq_len": 120,
                "equal_prior": false
            },
            "optimizer": {
                "lr": 1e-4,
                "weight_decay": 1e-2
            },
            "train": {
                "train_batch_size": 64,
                "val_batch_size": 64,
                "clip_grad_norm": 0.5,
                "epochs": 200,
                "min_epochs": 10,
                "early_stopping": true,
                "early_stop_patience": 20,
                "early_stop_min_delta": 1e-5
            },
            "scheduler": {
                "factor": 0.5,
                "patience": 10,
                "min_lr": 1e-6
            }
        }
    },
    "losses": {
        "custom_loss_1" : {
            "lambda1": 0.01
        },
        "custom_loss_2" : {
            "lambda1": 0.01
        },
        "custom_loss_3" : {
            "lambda1": 0.01
        },
        "custom_loss_4" : {
            "lambda1": 0.01
        },
        "custom_loss_5" : {
            "lambda1": 10
        },
        "custom_loss_6" : {
            "lambda1": 0.01,
            "lambda2": 0.1
        },
        "custom_loss_7" : {
            "lambda1": 0.01,
            "lambda2": 0.1
        },
        "custom_loss_8" : {
            "log_ret_lambda": 0.01,
            "cvar_lambda": 0.1,
            "risk_p_lambda": 0.1
        },
        "custom_loss_9" : {
            "lambda1": 0.01,
            "lambda2": 0.1
        },
        "custom_loss_10" : {
            "lambdas": {
                "cvar_lambda": 0.1,
                "risk_p_lambda": 0.1
            },
            "tuning": {
                "cvar_lambda": {"type": "categorical", "choices": [0.001, 0.01, 0.1, 1]},
                "risk_p_lambda": {"type": "categorical", "choices": [0.001, 0.01, 0.1, 1]}
            }
        },
        "custom_loss_11" : {
            "cvar_lambda": 0.01,
            "risk_p_lambda": 0.1
        }
    },
    "trad_models": {
        "GlobalMinimumVariance": {
            "allow_short": false
        },
        "MeanVariancePortfolio": {
            "expected_returns_method": "arithmetic",
            "risk_aversion": 1.0,
            "allow_short": false
        },
        "NestedClusteredOptimization": {
            "de_noise": true
        }
    }
}
