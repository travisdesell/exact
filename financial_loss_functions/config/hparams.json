        },
        "train": {
            "train_batch_size": 256,
            "val_batch_size": 1,
            "clip_grad_norm": 0.5,
            "epochs": 300,
            "early_stopping_patience": 15,
            "lr_scheduler_patience": 7,
            "lr_scheduler_factor": 0.5
